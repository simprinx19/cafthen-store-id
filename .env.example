db_MONGODB_URI="mongodb+srv://Vercel-Admin-db_compro:A4UTfZd22cX8a9l7@db-compro.orkvkuj.mongodb.net/?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://Vercel-Admin-db_compro:A4UTfZd22cX8a9l7@db-compro.orkvkuj.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="db-compro"
MONGODB_DB_NAME="db-compro"
COLLECTION_NAME="app_storage"
MONGODB_COLLECTION="app_storage"
